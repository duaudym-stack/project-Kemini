# process_7 — API 키 설정
# 1) 이 파일에 실제 키를 입력하세요
# 2) cd backend && python -m figure_planner.encrypt_key_env  (key.env → key.env.enc 암호화)
# 3) key.env 는 .gitignore 됩니다. 절대 커밋하지 마세요.

# ── LLM (필수: OpenAI 또는 Gemini 중 하나) ──────────────────────
LLM_PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ── 이미지 생성 ──────────────────────────────────────────────────
# OpenAI DALL-E (기본 — OPENAI_API_KEY가 있으면 자동 사용)
IMAGE_PROVIDER=openai
# OPENAI_IMAGE_MODEL=dall-e-3  # 기본값, gpt-image-1 도 가능

# Google AI Studio (선택): https://aistudio.google.com/apikey
# IMAGE_PROVIDER=gemini
# GEMINI_API_KEY=여기에_Gemini_API_키_입력
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Leonardo.ai (선택)
# IMAGE_PROVIDER=leonardo
# IMAGE_API_KEY=Leonardo_API_키
# LEONARDO_MODEL_ID=1e60896f-3c26-4296-8ecc-53e2afecc132

# ── 파이프라인 옵션 ─────────────────────────────────────────────
SELF_CONSISTENCY_N=3
ENABLE_CRITIC=true
MAX_FIGURES=8
ENABLE_HYBRID=true
MAX_VISION_PAGES=8

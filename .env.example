# Figure Planner v2.1 — 환경 변수
# 이 파일을 .env로 복사한 뒤 API 키를 입력하세요.

# LLM Provider: "gemini" / "openai" / "anthropic"
LLM_PROVIDER=gemini

# Google Gemini (기본 provider)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Self-Consistency 횟수 (기본 3)
SELF_CONSISTENCY_N=3

# Critic Pass 활성화 (기본 true)
ENABLE_CRITIC=true

# 최대 그림 개수 (기본 8)
MAX_FIGURES=8

# 하이브리드 페이지 이미지+텍스트 분석
ENABLE_HYBRID=true
MAX_VISION_PAGES=8
